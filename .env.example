# ============================================================================
# Fiserv Goons Draft Assistant — environment variables
# Copy this file to `.env` (repo root, for the pipeline) AND create
# `web/.env` (for the frontend) with the VITE_ vars. Never commit real keys.
# ============================================================================

# --- Data pipeline (root .env) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
CFBD_API_KEY=your-collegefootballdata-key-here
FANTASYPROS_API_KEY=your-fantasypros-key-here

# --- Frontend (web/.env) ---
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
